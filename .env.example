# ---- Securite de la console (obligatoire) ----
CONSOLE_PASSWORD=choisissez-un-mot-de-passe-long
SESSION_SECRET=chaine-aleatoire-longue-32-caracteres-minimum

# Mettre a 1 pour essayer l'interface avec des donnees fictives (aucune cle requise ; mot de passe "demo" si CONSOLE_PASSWORD est vide)
DEMO_MODE=0

# ---- Vercel : hebergement & deploiements (prefixe VC_ car Vercel reserve le prefixe VERCEL_) ----
VC_API_TOKEN=
VC_TEAM_ID=

# ---- GitHub : code ----
GITHUB_TOKEN=
GITHUB_ORGS=

# ---- Resend : courriels ----
RESEND_API_KEY=

# ---- Porkbun : domaines & DNS ----
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ---- Stripe : paiements ----
STRIPE_SECRET_KEY=
